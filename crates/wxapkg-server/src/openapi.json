    "/api/verify": {
      "post": {
        "tags": [
          "local"
        ],
        "summary": "Validate a reconstructed project",
        "description": "Structural checks over app.json, page files, require/import resolution and delimiter balance. With node=true a real JavaScript syntax check runs too.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "dir"
                ],
                "properties": {
                  "dir": {
                    "type": "string",
                    "description": "Project directory to validate."
                  },
                  "node": {
                    "type": "boolean",
                    "default": false,
                    "description": "Run node --check over every .js/.wxs file."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The operation report, wrapped in the standard envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Verify"
                }
              }
            }
          },
          "400": {
            "description": "The request is malformed."
          },
          "500": {
            "description": "The operation failed."
          }
        },
        "operationId": "verify_post"
      }
